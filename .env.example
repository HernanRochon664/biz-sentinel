# URI for MLflow tracking server - Optional
MLFLOW_TRACKING_URI=

# Name of the MLflow experiment to use - Optional
MLFLOW_EXPERIMENT_NAME=biz-sentinel

# URL for the Prefect API server - Optional
PREFECT_API_URL=

# Database connection string - Required
DATABASE_URL=sqlite:///data/biz_sentinel.db

# Secret key for JWT token signing - Required for authentication
SECRET_KEY=

# Salt for HMAC-based pseudonymization - Required for data anonymization
HMAC_SALT=

# Base URL for Ollama API - Optional
OLLAMA_BASE_URL=http://localhost:11434

# Model to use with Ollama - Optional
OLLAMA_MODEL=llama3.1:8b

# Logging level (DEBUG, INFO, WARNING, ERROR) - Optional
LOG_LEVEL=INFO

# Environment identifier (development, staging, production) - Optional
ENVIRONMENT=development

# Local Running
LANDING_URL=http://localhost:8055
DASHBOARD_URL=http://localhost:8050
CHAT_URL=http://localhost:8060
CHAT_ENABLED=true
